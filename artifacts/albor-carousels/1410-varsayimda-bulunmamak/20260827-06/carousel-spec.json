      "art_box": [340, 775, 1080, 1350],
      "art_opacity": 0.94
    },
    {
      "main_lines": [
        "Ama adam",
        "ne beklendiğini bilmiyordu.",
        "Söylenmeyen beklenti",
        "karşılanmayınca,",
        "çatışma büyüdü."
      ],
      "support_lines": [],
      "accent_focus": {
        "block": "main",
        "line": 4,
        "text": "çatışma büyüdü.",
