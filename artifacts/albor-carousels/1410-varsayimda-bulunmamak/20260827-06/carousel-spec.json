    {
      "main_lines": [
        "Ruiz burada",
        "iki yolu ayırdı:",
        "cevabı varsaymak",
        "ya da bilmediğini kabul edip",
        "açıkça sormak."
      ],
      "support_lines": [],
      "accent_focus": {
