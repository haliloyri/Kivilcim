  "slides": [
    {
      "main_lines": [
        "Bir isteği hiç söylemeden",
        "karşındakinin bilmesini",
        "beklersen ne olur?",
        "Ruiz’in örneğinde,",
        "gerilim eve dönüşte başladı."
      ],
      "support_lines": [],
      "accent_focus": {
        "block": "main",
