      "art_box": [250, 785, 1080, 1350],
      "art_opacity": 0.94
    },
    {
      "main_lines": [
        "Adam eve geldi.",
        "Eşi öfkeliydi.",
        "Ama ne istediğini",
        "ona hiç söylememişti.",
        "Adam nedenini bilmiyordu."
      ],
      "support_lines": [],
      "accent_focus": {
        "block": "illustration"
      },
      "art_crop": [0.28, 0.43, 1.0, 1.0],
      "art_box": [250, 770, 1080, 1350],
      "art_opacity": 0.94
    },
    {
      "main_lines": [
        "Kadın",
        "eşinin onu çok iyi tanıdığına",
        "inanıyordu.",
        "Bu yüzden isteğini",
        "zaten bilmesini bekledi."
      ],
      "support_lines": [],
      "accent_focus": {
        "block": "main",
        "line": 4,
        "text": "zaten bilmesini",
        "font_style": "bold_italic"
