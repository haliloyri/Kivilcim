    {
      "main_lines": [
        "Bugün bir yorumunu seç.",
        "Onu hemen doğru sayma.",
        "Küçük bir soruya çevir:",
        "Bunu doğru mu anladım?",
        "Sonra cevabı dinle."
      ],
      "support_lines": [],
      "accent_focus": {
        "block": "main",
