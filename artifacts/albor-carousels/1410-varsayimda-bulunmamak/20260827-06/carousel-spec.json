      "art_opacity": 0.94
    },
    {
      "main_lines": [
        "İlk bakışta sorun",
        "adamın anlayamamasıydı.",
        "Oysa gerilimi büyüten",
        "söylenmeyen bir istek",
        "ve zihin okuma beklentisiydi."
      ],
      "support_lines": [],
      "accent_focus": {
        "block": "main",
        "line": 4,
        "text": "zihin okuma",
