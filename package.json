{
  "name": "kivilcim",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "kill-port": "lsof -ti:8081 | xargs kill -9 2>/dev/null || true",
    "start": "npm run kill-port && expo start --port 8081",
    "android": "npm run kill-port && expo run:android --port 8081",
    "ios": "npm run kill-port && expo run:ios --port 8081",
    "web": "expo start --web",
    "build:apk:dev": "eas build --platform android --profile development",
    "build:apk": "eas build --platform android --profile apk",
    "build:apk:local": "eas build --platform android --profile apk --local",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "merge": "node scripts/merge.mjs"
  },
