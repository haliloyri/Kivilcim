# Şablonu .env.local olarak kopyalayın. Gerçek API anahtarını Git'e eklemeyin.
# ElevenLabs panelinden API key oluşturup yalnızca .env.local içine yazın.
ELEVENLABS_API_KEY=
# Boş bırakılırsa create-voiceover.mjs hikâye kategorisine göre otomatik ses seçer.
ELEVENLABS_VOICE_ID=
# Türkçe uzun anlatımlar için önerilen model.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# forced yalnızca hesabınızda forced_alignment yetkisi varsa kullanılmalı.
ELEVENLABS_ALIGNMENT_MODE=local
FFMPEG_BIN=ffmpeg
