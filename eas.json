{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CAREER_PATH_V1": "true",
        "EXPO_PUBLIC_CAREER_EVENT_CAPTURE_V1": "true"
      }
    },
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_CAREER_PATH_V1": "true",
        "EXPO_PUBLIC_CAREER_EVENT_CAPTURE_V1": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CAREER_PATH_V1": "true",
        "EXPO_PUBLIC_CAREER_EVENT_CAPTURE_V1": "true"
      }
    },
    "production": {
      "ios": {
        "buildConfiguration": "Release",
        "credentialsSource": "remote"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_CAREER_PATH_V1": "true",
        "EXPO_PUBLIC_CAREER_EVENT_CAPTURE_V1": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
